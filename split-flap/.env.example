# Copy to .env and fill in. .env is git-ignored.
SOLIDPIXELS_API_TOKEN=
SOLIDPIXELS_DEVICE_ID=69855bce722f6c439c0f5fd4

# Reference point (defaults: KPHX)
LAT=33.4342
LON=-112.0116
FIELD_ELEV_FT=1135
TIME_ZONE=America/Phoenix

LABEL=PHX
# fids = ARRIVALS / DEPARTURES with route lookup; overhead = callsign / type / altitude
BOARD=fids
# codes that count as "this airport" for arrivals/departures
HOME_AIRPORT=PHX,KPHX
# NEAR page for traffic without a known route: auto (only when the board is thin), true, false
SHOW_NEARBY=auto
RANGE_NM=40
MAX_PAGES=4
INTERVAL_S=60
INSTALLATION_ID=kphx-split-flap
