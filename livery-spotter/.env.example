# Copy to .env and fill in. .env is git-ignored.
SOLIDPIXELS_API_TOKEN=
SOLIDPIXELS_DEVICE_ID=69855bce722f6c439c0f5fd4

# Reference point (defaults: KPHX)
LAT=33.4342
LON=-112.0116
FIELD_ELEV_FT=1135
TIME_ZONE=America/Phoenix

# search radius, and how close an aircraft must be to be "spotted"
RANGE_NM=15
SPOT_NM=8
INTERVAL_S=20
INCLUDE_GA=true
# force background: day | dawn | dusk | night (blank = follow the clock)
TOD=
INSTALLATION_ID=livery-spotter
